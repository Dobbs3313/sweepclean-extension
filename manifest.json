{
  "manifest_version": 3,
  "name": "SweepClean — Ad-Free Privacy Cleaner",
  "short_name": "SweepClean",
  "description": "Zero-ad 1-click Chrome cache, history, and cookie cleaner with Protected Domains so you stay logged into key sites.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SweepClean",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "browsingData",
    "cookies",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
